# 晶体智能助手 — 环境变量配置
# 复制此文件为 .env 并填入实际密钥

# ========== 必填 ==========
# DeepSeek API（LLM 对话功能，必需）
DEEPSEEK_API_KEY=sk-your-key-here

# ========== Phase 4+（可选，缺失时对应工具不可用）==========
# Materials Project API（晶体数据查询）
MP_API_KEY=your-mp-key-here

# SerpAPI（联网搜索）
SERPAPI_API_KEY=your-serpapi-key-here

# ========== 服务配置（可选）==========
# HOST=localhost
# PORT=8000
